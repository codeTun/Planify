{
  "name": "planify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "k8s:deploy": "kubectl apply -f kubernetes/",
    "k8s:delete": "kubectl delete namespace planify",
    "k8s:status": "kubectl get all -n planify",
    "k8s:logs": "kubectl logs -f deployment/planify-app -n planify",
    "k8s:pods": "kubectl get pods -n planify"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
